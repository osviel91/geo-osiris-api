# Rendered by the official nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/geo-admin.conf. ${ADMIN_PROXY_SECRET} is substituted from
# the container environment; introduce no other ${...} tokens here.
#
# Two TLS vhosts share one certificate:
#   auth.osiris.home.arpa      -> Authelia portal (no forward-auth)
#   geo-admin.osiris.home.arpa -> Authelia forward-auth, then Geo Admin

server {
    listen 443 ssl;
    http2 on;
    server_name auth.osiris.home.arpa;

    ssl_certificate     /etc/nginx/certs/osiris.home.arpa.pem;
    ssl_certificate_key /etc/nginx/certs/osiris.home.arpa-key.pem;

    location / {
        proxy_pass http://authelia:9091;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name geo-admin.osiris.home.arpa;

    ssl_certificate     /etc/nginx/certs/osiris.home.arpa.pem;
    ssl_certificate_key /etc/nginx/certs/osiris.home.arpa-key.pem;

    location = /internal/authelia/authz {
        internal;
        proxy_pass http://authelia:9091/api/authz/auth-request;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
        proxy_set_header X-Forwarded-Method $request_method;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-URI $request_uri;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        auth_request /internal/authelia/authz;
        auth_request_set $authz_user $upstream_http_remote_user;
        auth_request_set $authz_groups $upstream_http_remote_groups;
        auth_request_set $authz_name $upstream_http_remote_name;
        auth_request_set $authz_email $upstream_http_remote_email;
        auth_request_set $target_url $scheme://$http_host$request_uri;

        # Send unauthenticated browsers to the Authelia portal and back.
        error_page 401 =302 https://auth.osiris.home.arpa/?rd=$target_url;

        # Drop client-supplied trust headers, then inject the identity Authelia
        # proved for this request. Geo Admin trusts Remote-* only when
        # X-Proxy-Secret matches ADMIN_PROXY_SECRET.
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Auth-Request-User "";
        proxy_set_header X-Auth-Request-Email "";
        proxy_set_header X-Auth-Request-Groups "";
        proxy_set_header Remote-User $authz_user;
        proxy_set_header Remote-Groups $authz_groups;
        proxy_set_header Remote-Name $authz_name;
        proxy_set_header Remote-Email $authz_email;
        proxy_set_header X-Proxy-Secret ${ADMIN_PROXY_SECRET};

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_pass http://geo-admin:3000;
    }
}
