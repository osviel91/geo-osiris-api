# Copy to .env.staging and fill in. Never commit real values.
#
# Required secrets
POSTGRES_PASSWORD=
# Scoped credentials. Use independent random values; do not reuse these scopes.
GEO_READ_TOKEN=
GEO_STAGE_TOKEN=
GEO_PUBLISH_TOKEN=
GEO_ADMIN_TOKEN=
# Optional AEMET external source sync. Without it, sync records a failed
# attempt and keeps last-known-good published data.
AEMET_API_KEY=

# --- Phase 10D: Authelia forward-auth + TLS proxy ---
# Random 32-byte hex values; generate each with `openssl rand -hex 32`.
# Never reuse another secret.
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# Shared proof-of-proxy secret. Must match the value Geo Admin reads.
ADMIN_PROXY_SECRET=

# Image references. Defaults are the local SHA tags built for this checkpoint.
# For production, pin by digest instead, e.g.
#   GEO_API_IMAGE=ghcr.io/osviel91/geo-osiris-api@sha256:<digest>
GEO_API_IMAGE=geo-osiris-api:sha-0ef6d4a
GEO_ADMIN_IMAGE=geo-osiris-admin:sha-0926b36
OSIRIS_IMAGE=osiris:sha-a353dce
GEO_PUBLISHER_IMAGE=geo-osiris-publisher:phase-6c

# Published host ports. Only the TLS proxy (admin) and OSIRIS are exposed;
# geo-admin itself is Docker-internal.
ADMIN_HTTPS_PORT=443
OSIRIS_PORT=3000

# Geo API CORS. Leave empty: Admin and OSIRIS reach the API server-side and do
# not need browser CORS. Do not set to "*".
CORS_ORIGINS=
